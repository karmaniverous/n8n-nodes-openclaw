{
  "name": "message",
  "label": "Message",
  "description": "Send, delete, and manage messages via channel plugins (Slack, Discord, Telegram, etc.). Supports sending text, media, reactions, polls, threads, pins, moderation, and more.",
  "actions": [
    "send", "broadcast", "react", "reactions", "read", "edit", "delete",
    "pin", "unpin", "list-pins", "member-info", "emoji-list",
    "reply", "sendWithEffect", "sendAttachment",
    "thread-create", "thread-list", "thread-reply", "search",
    "poll", "sticker", "sticker-search",
    "channel-info", "channel-list", "channel-create", "channel-edit", "channel-delete",
    "timeout", "kick", "ban"
  ],
  "parameters": {
    "action": {
      "type": "string",
      "required": true,
      "enum": [
        "send", "broadcast", "react", "reactions", "read", "edit", "delete",
        "pin", "unpin", "list-pins", "member-info", "emoji-list",
        "reply", "sendWithEffect", "sendAttachment",
        "thread-create", "thread-list", "thread-reply", "search",
        "poll", "sticker", "sticker-search",
        "channel-info", "channel-list", "channel-create", "channel-edit", "channel-delete",
        "timeout", "kick", "ban"
      ],
      "description": "The messaging operation to perform"
    },
    "channel": {
      "type": "string",
      "required": false,
      "description": "Channel plugin to use (e.g. 'slack', 'discord', 'telegram'). Required when multiple channel plugins are configured."
    },
    "target": {
      "type": "string",
      "required": false,
      "description": "Target channel/user ID or name",
      "displayOptions": { "show": { "action": ["send", "broadcast", "reply", "sendWithEffect", "sendAttachment", "read", "react", "reactions", "edit", "delete", "pin", "unpin", "list-pins", "member-info", "emoji-list", "poll", "thread-create", "thread-list", "search", "channel-info", "channel-edit", "channel-delete", "timeout", "kick", "ban"] } }
    },
    "message": {
      "type": "string",
      "required": false,
      "description": "Message text content",
      "displayOptions": { "show": { "action": ["send", "broadcast", "reply", "edit", "thread-reply", "sendWithEffect"] } }
    },
    "messageId": {
      "type": "string",
      "required": false,
      "description": "Message ID to target for edit, delete, react, pin operations",
      "displayOptions": { "show": { "action": ["edit", "delete", "react", "reactions", "pin", "unpin"] } }
    },
    "media": {
      "type": "string",
      "required": false,
      "description": "Media URL or local file path to attach",
      "displayOptions": { "show": { "action": ["send", "sendAttachment", "reply", "thread-reply"] } }
    },
    "filePath": {
      "type": "string",
      "required": false,
      "description": "Local file path for attachment",
      "displayOptions": { "show": { "action": ["send", "sendAttachment", "reply", "thread-reply"] } }
    },
    "caption": {
      "type": "string",
      "required": false,
      "description": "Caption for media attachments",
      "displayOptions": { "show": { "action": ["send", "sendAttachment", "reply", "thread-reply"] } }
    },
    "replyTo": {
      "type": "string",
      "required": false,
      "description": "Message ID to reply to",
      "displayOptions": { "show": { "action": ["reply", "thread-reply"] } }
    },
    "threadId": {
      "type": "string",
      "required": false,
      "description": "Thread ID for thread operations",
      "displayOptions": { "show": { "action": ["thread-reply", "thread-list"] } }
    },
    "threadName": {
      "type": "string",
      "required": false,
      "description": "Thread name for thread-create",
      "displayOptions": { "show": { "action": ["thread-create"] } }
    },
    "emoji": {
      "type": "string",
      "required": false,
      "description": "Emoji for reactions (e.g. 'thumbsup', '🎉')",
      "displayOptions": { "show": { "action": ["react"] } }
    },
    "remove": {
      "type": "boolean",
      "required": false,
      "description": "Remove a reaction instead of adding",
      "displayOptions": { "show": { "action": ["react"] } }
    },
    "limit": {
      "type": "number",
      "required": false,
      "description": "Maximum number of items to return",
      "displayOptions": { "show": { "action": ["read", "search", "thread-list", "channel-list", "emoji-list"] } }
    },
    "before": {
      "type": "string",
      "required": false,
      "description": "Read messages before this message ID",
      "displayOptions": { "show": { "action": ["read"] } }
    },
    "after": {
      "type": "string",
      "required": false,
      "description": "Read messages after this message ID",
      "displayOptions": { "show": { "action": ["read"] } }
    },
    "around": {
      "type": "string",
      "required": false,
      "description": "Read messages around this message ID",
      "displayOptions": { "show": { "action": ["read"] } }
    },
    "query": {
      "type": "string",
      "required": false,
      "description": "Search query string",
      "displayOptions": { "show": { "action": ["search", "sticker-search"] } }
    },
    "pollQuestion": {
      "type": "string",
      "required": false,
      "description": "Question text for the poll",
      "displayOptions": { "show": { "action": ["poll"] } }
    },
    "pollOption": {
      "type": "string",
      "required": false,
      "description": "Poll answer options (comma-separated)",
      "displayOptions": { "show": { "action": ["poll"] } },
      "splitAsArray": true
    },
    "pollDurationHours": {
      "type": "number",
      "required": false,
      "description": "Poll duration in hours",
      "displayOptions": { "show": { "action": ["poll"] } }
    },
    "pollMulti": {
      "type": "boolean",
      "required": false,
      "description": "Allow multiple poll answers",
      "displayOptions": { "show": { "action": ["poll"] } }
    },
    "silent": {
      "type": "boolean",
      "required": false,
      "description": "Send without triggering notifications",
      "displayOptions": { "show": { "action": ["send", "broadcast", "reply", "sendWithEffect", "sendAttachment", "thread-reply"] } }
    },
    "effectId": {
      "type": "string",
      "required": false,
      "description": "Message effect ID (e.g. 'invisible-ink', 'balloons')",
      "displayOptions": { "show": { "action": ["sendWithEffect"] } }
    },
    "name": {
      "type": "string",
      "required": false,
      "description": "Name for channel create or edit operations",
      "displayOptions": { "show": { "action": ["channel-create", "channel-edit"] } }
    },
    "channelId": {
      "type": "string",
      "required": false,
      "description": "Channel ID filter for searches and thread lists",
      "displayOptions": { "show": { "action": ["search", "thread-list"] } }
    },
    "userId": {
      "type": "string",
      "required": false,
      "description": "User ID for moderation or member operations",
      "displayOptions": { "show": { "action": ["timeout", "kick", "ban", "member-info"] } }
    },
    "reason": {
      "type": "string",
      "required": false,
      "description": "Reason for moderation actions",
      "displayOptions": { "show": { "action": ["timeout", "kick", "ban"] } }
    },
    "dryRun": {
      "type": "boolean",
      "required": false,
      "description": "Preview the operation without executing it",
      "displayOptions": { "show": { "action": ["send", "broadcast"] } }
    },
    "timeoutMs": {
      "type": "number",
      "required": false,
      "description": "Timeout in milliseconds for the operation"
    }
  }
}
